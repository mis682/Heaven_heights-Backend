MONGO_URI=mongodb://127.0.0.1:27017/heavenheights
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
SERVER_BASE_URL=http://localhost:5000
AUTH_SECRET=
CRON_SECRET=

ADMIN_PASSWORD=
SECURITY_MANAGER_PASSWORD=
COORDINATOR_PASSWORD=

# Cloudinary — Primary account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary — Housekeeping account (separate free-tier quota)
CLOUDINARY_HOUSEKEEPING_CLOUD_NAME=
CLOUDINARY_HOUSEKEEPING_API_KEY=
CLOUDINARY_HOUSEKEEPING_API_SECRET=

# Cloudinary — optional fallback tiers (3 onward). Leave unset to skip a tier;
# add CLOUDINARY_FALLBACK<N>_* for as many as needed, no code change required.
CLOUDINARY_FALLBACK3_CLOUD_NAME=
CLOUDINARY_FALLBACK3_API_KEY=
CLOUDINARY_FALLBACK3_API_SECRET=
CLOUDINARY_FALLBACK4_CLOUD_NAME=
CLOUDINARY_FALLBACK4_API_KEY=
CLOUDINARY_FALLBACK4_API_SECRET=
CLOUDINARY_FALLBACK5_CLOUD_NAME=
CLOUDINARY_FALLBACK5_API_KEY=
CLOUDINARY_FALLBACK5_API_SECRET=
CLOUDINARY_FALLBACK6_CLOUD_NAME=
CLOUDINARY_FALLBACK6_API_KEY=
CLOUDINARY_FALLBACK6_API_SECRET=

# Google Drive (media archival + daily Mongo backup)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# Email alerts (Resend) — Cloudinary usage threshold alerts
RESEND_API_KEY=
RESEND_FROM=
ALERT_EMAIL_TO=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n webhooks — per-module, each optional. Modules without their own
# N8N_<MODULE>_WEBHOOK_URL fall back to the shared N8N_WEBHOOK_URL.
N8N_WEBHOOK_URL=
N8N_ATTENDANCE_WEBHOOK_URL=
N8N_FIRE_MOCK_DRILL_WEBHOOK_URL=
N8N_GC_CLUB_WEBHOOK_URL=
N8N_GC_HOUSEKEEPING_WEBHOOK_URL=
N8N_ONE_BUSINESS_CENTER_WEBHOOK_URL=

# Initial admin seed — only used on first boot if no admin user exists yet
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
